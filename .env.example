EXPO_PUBLIC_API_BASE_URL=https://sandbox3.staging.iamwarpspeed.com/v1
EXPO_PUBLIC_SOCKET_URL=https://sandbox3.staging.iamwarpspeed.com
EXPO_PUBLIC_ENABLE_DEV_LOGS=true

# Do not put credentials in the repo. Copy this file to gitignored `.env`.
# App sign-in: use the UI with the assigned sandbox account.
# Optional — only for npm run sandbox:* scripts (never EXPO_PUBLIC_*):
# SANDBOX_EMAIL=
# SANDBOX_PASSWORD=
